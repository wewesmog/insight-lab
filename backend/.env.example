# SQLite path (default: backend/data/insight_lab.db)
# DATABASE_PATH=backend/data/insight_lab.db

# Switch: ollama | openai | gemini
# LLM_PROVIDER=ollama
# LLM_MODEL=...   # optional override for any provider

# Ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Gemini (instructor) — GOOGLE_API_KEY or GEMINI_API_KEY
# GOOGLE_API_KEY=...
# LLM_MODEL=gemini-2.0-flash
